# Opcao 1 — Postgres nativo que voce ja usa (mesmo servidor da v1, banco novo):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chronos_flow_v2?schema=public"

# Opcao 2 — container isolado do docker-compose.yml (porta 5433):
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/chronos_flow_v2?schema=public"

PORT=3101
NODE_ENV=development
GEMINI_API_KEY=

# Contas. Sem convite, so a primeira conta pode ser criada, e so desta propria
# maquina (ela herda os dados que ja estavam no banco); depois o cadastro fecha.
# Com convite, qualquer um com o codigo cria conta — inclusive a primeira, de
# qualquer lugar. Servidor acessado pela rede/nuvem: defina o convite.
CHRONOS_CONVITE=

# true forca o cookie de sessao como Secure. Atras de HTTPS (tunel da
# Cloudflare, proxy) isso ja e detectado pelo X-Forwarded-Proto.
CHRONOS_COOKIE_SEGURO=

# off desliga o anuncio na rede local (Bonjour/UDP) usado pelo iPhone para
# achar o computador. Na nuvem nao ha rede local: use off.
CHRONOS_DESCOBERTA=

# Interface onde o servidor escuta. 127.0.0.1 fecha para a rede de vez.
HOST=0.0.0.0
