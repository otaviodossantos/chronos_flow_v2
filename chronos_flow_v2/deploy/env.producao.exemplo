# Copie para .env ao lado do compose.yaml e preencha. Nunca commite o arquivo preenchido.

# Banco proprio do Chronos (ver criar-banco.sql). sslmode=require para Postgres
# gerenciado (o RDS com Postgres 16+ exige SSL); connection_limit segura o pool
# do Prisma.
DATABASE_URL="postgresql://chronos:SENHA_DO_BANCO@HOST_DO_BANCO:5432/chronos?schema=public&sslmode=require&connection_limit=5"

# Codigo para criar conta. Obrigatorio em servidor acessado pela rede: sem ele,
# ninguem cria a primeira conta de fora (o servidor avisa no log), e e ele que
# controla quem mais pode ter conta. Algo longo e aleatorio (openssl rand -base64 24).
CHRONOS_CONVITE=

# Atras de HTTPS (proxy, tunel, load balancer): cookie de sessao so por HTTPS.
CHRONOS_COOKIE_SEGURO=true
# Sem rede local para o iPhone achar o computador: desliga o anuncio.
CHRONOS_DESCOBERTA=off
CHRONOS_NOME=Chronos Flow

# Opcional: chave do Gemini usada por todas as contas que nao configurarem a
# propria em Configuracoes.
GEMINI_API_KEY=
